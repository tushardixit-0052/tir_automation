              "name": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "username": { "type": "string" }
            },
            "additionalProperties": false
          },
          "service_type": { "type": "string" },
          "service_id": { "type": ["integer", "null"] },
          "location": { "type": "string" }
        },
        "additionalProperties": false
      },
      "errors": {
        "type": "object",
        "maxProperties": 0
      },
      "message": {
        "type": "string"
      }
    }
  }
  