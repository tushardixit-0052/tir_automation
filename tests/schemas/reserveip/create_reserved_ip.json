          "id",
          "ip_address",
          "service_name",
          "created_at",
          "status",
          "reserved_by",
          "service_type",
          "service_id",
          "location"
        ],
        "properties": {
          "id": { "type": "integer" },
          "ip_address": {
            "type": "string",
