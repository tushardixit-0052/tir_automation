{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "code": { "type": "integer", "const": 200 },
      "message": { "type": "string" },
      "errors": { "type": "object" },
      "data": {
        "type": "object",
        "properties": {
          "pod_events": { "type": "array" },
          "pod_info": {
            "type": "object",
            "properties": {
              "apiVersion": { "type": "string" },
              "kind": { "type": "string", "const": "Pod" },
              "metadata": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "namespace": { "type": "string" },
                  "creationTimestamp": { "type": "string", "format": "date-time" }
                },
                "required": ["name", "namespace"]
              },
              "spec": {
                "type": "object",
                "properties": {
                  "nodeName": { "type": "string" },
                  "restartPolicy": { "type": "string" },
                  "containers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "image": { "type": "string" },
                        "resources": {
                          "type": "object",
                          "properties": {
                            "limits": { "type": "object" },
                            "requests": { "type": "object" }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "status": {
                "type": "object",
                "properties": {
                  "phase": { "type": "string", "enum": ["Pending", "Running", "Succeeded", "Failed", "Unknown"] },
                  "podIP": { "type": "string" },
                  "hostIP": { "type": "string" },
                  "containerStatuses": { "type": "array" }
                },
                "required": ["phase"]
              }
            },
            "required": ["metadata", "spec", "status"]
          }
        },
        "required": ["pod_info"]
      }
    },
    "required": ["code", "data", "message"]
  }