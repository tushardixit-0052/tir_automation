{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Dataset Mount Status Schema",
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "const": 200
      },
      "message": {
        "type": "string",
        "const": "Success"
      },
      "errors": {
        "type": "object"
      },
      "data": {
        "type": "object",
        "properties": {
          "mounted_datasets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unmounted_datasets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["mounted_datasets", "unmounted_datasets"],
        "additionalProperties": false
      }
    },
    "required": ["code", "data", "message", "errors"],
    "additionalProperties": false
  }
  