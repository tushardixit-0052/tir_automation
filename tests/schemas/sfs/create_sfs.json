{
    "type": "object",
    "required": ["code", "data", "errors", "message"],
    "properties": {
      "code": {
        "type": "integer",
        "enum": [200]
      },
      "message": {
        "type": "string"
      },
      "errors": {
        "type": "object"
      },
      "data": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created_by",
          "sfs_ip",
          "created_at",
          "disk_size",
          "size_in_gb",
          "location"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "pattern": ".*file-system-.*"
          },
          "created_by": {
            "type": "integer"
          },
          "sfs_ip": {
            "type": "string",
            "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "disk_size": {
            "type": "string",
            "pattern": "^[0-9]+ GB$"
          },
          "size_in_gb": {
            "type": "string",
            "pattern": "^[0-9]+ GB$"
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  }
  